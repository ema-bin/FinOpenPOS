{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["pdx1"],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/daily-sales-closure",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/court-reservations",
      "schedule": "0 6 * * 6"
    }
  ]
}

